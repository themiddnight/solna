{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/main.tsx",
    "server.ts",
    "lingui.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "src/engine/index.ts",
    "src/engine/effects/index.ts",
    "src/engine/instruments/index.ts",
    "scripts/generate-icon-bundle.ts",
    "scripts/validate-icon-registry.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "server.ts", "scripts/**/*.ts"],
  "ignore": [
    "src/**/*.d.ts",
    "src/locales/**/messages.js",
    "public/worklets/**"
  ],
  "ignoreBinaries": [],
  "ignoreDependencies": [
    "daisyui",
    "tailwindcss",
    "@trivago/prettier-plugin-sort-imports",
    "@eslint-community/eslint-plugin-eslint-comments"
  ]
}
