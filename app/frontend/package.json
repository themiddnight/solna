{
  "name": "collab-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run i18n:compile && tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "type-check": "tsc -b tsconfig.app.json tsconfig.node.json tsconfig.server.json tsconfig.test.json --pretty false && tsc --noEmit -p tsconfig.scripts.json --pretty false",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "knip": "knip --no-config-hints",
    "knip:gate": "knip --no-config-hints --include files,dependencies,unlisted,exports",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "icons:bundle": "bun run scripts/generate-icon-bundle.ts",
    "icons:validate": "bun run scripts/validate-icon-registry.ts",
    "preview": "vite preview",
    "format": "prettier --write src/ --plugin=@trivago/prettier-plugin-sort-imports",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:watch": "vitest --exclude \"e2e/**\"",
    "test:unit": "vitest run --exclude \"e2e/**\" --exclude \"**/*.{integration,regression}.test.{ts,tsx}\" --exclude \"**/__tests__/regression/**\"",
    "test:integration": "vitest run integration",
    "test:regression": "vitest run regression",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --exclude \"e2e/**\"",
    "test:e2e": "E2E_RUN_WEBRTC=true playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:auth": "playwright test --project=chromium e2e/auth/",
    "test:e2e:room": "playwright test --project=chromium e2e/room-lifecycle/",
    "test:e2e:realtime": "playwright test --project=chromium e2e/realtime/",
    "test:e2e:project": "playwright test --project=chromium e2e/project/",
    "test:e2e:auth:w1": "playwright test --project=chromium --workers=1 e2e/auth/",
    "test:e2e:room:w1": "playwright test --project=chromium --workers=1 e2e/room-lifecycle/",
    "test:e2e:realtime:w1": "playwright test --project=chromium --workers=1 e2e/realtime/",
    "test:e2e:project:w1": "playwright test --project=chromium --workers=1 e2e/project/",
    "test:e2e:parallel": "E2E_WORKERS=3 E2E_FULLY_PARALLEL=true playwright test --project=chromium",
    "test:e2e:parallel:auth": "E2E_WORKERS=2 E2E_FULLY_PARALLEL=true playwright test e2e/auth/",
    "test:e2e:parallel:room": "E2E_WORKERS=1 E2E_FULLY_PARALLEL=false playwright test --project=chromium e2e/room-lifecycle/",
    "test:e2e:parallel:realtime": "E2E_WORKERS=1 E2E_FULLY_PARALLEL=false playwright test --project=chromium e2e/realtime/",
    "test:e2e:parallel:project": "E2E_WORKERS=2 E2E_FULLY_PARALLEL=true playwright test --project=chromium e2e/project/",
    "test:e2e:auth:repeat": "for i in 1 2 3; do bun run test:e2e:auth:w1 || exit 1; done",
    "test:e2e:room:repeat": "for i in 1 2 3; do bun run test:e2e:room:w1 || exit 1; done",
    "test:e2e:realtime:repeat": "for i in 1 2 3; do bun run test:e2e:realtime:w1 || exit 1; done",
    "test:e2e:webrtc": "E2E_RUN_WEBRTC=true playwright test --project=chromium --workers=1 e2e/webrtc/",
    "test:e2e:webrtc:repeat": "for i in 1 2 3; do bun run test:e2e:webrtc || exit 1; done",
    "test:e2e:project:repeat": "for i in 1 2 3; do bun run test:e2e:project:w1 || exit 1; done",
    "test:e2e:misc": "playwright test --project=chromium e2e/smoke.spec.ts e2e/onboarding-tour.spec.ts e2e/companion/ e2e/effects/",
    "test:e2e:misc:w1": "playwright test --project=chromium --workers=1 e2e/smoke.spec.ts e2e/onboarding-tour.spec.ts e2e/companion/ e2e/effects/",
    "test:e2e:sequential": "bun run test:e2e:auth:w1 && bun run test:e2e:room:w1 && bun run test:e2e:realtime:w1 && bun run test:e2e:project:w1 && bun run test:e2e:misc:w1",
    "test:e2e:fast": "bun run test:e2e:parallel:auth && bun run test:e2e:room:w1 && bun run test:e2e:parallel:realtime && bun run test:e2e:project:w1 && bun run test:e2e:misc:w1",
    "e2e:seed": "bun run --cwd ../backend seed:e2e-users && bun e2e/scripts/seed-e2e-projects.ts",
    "calibration:generate": "bun run scripts/calibration/generateTrimTable.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@floating-ui/react": "^0.27.20",
    "@iconify/react": "^6.0.2",
    "@jam-band/shared": "workspace:*",
    "@lingui/core": "^6.4.0",
    "@lingui/react": "^6.4.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.83.0",
    "@tonejs/midi": "^2.0.28",
    "axios": "^1.11.0",
    "axios-retry": "^4.5.0",
    "daisyui": "^5.0.46",
    "hls.js": "^1.6.15",
    "jszip": "^3.10.1",
    "konva": "^10.0.8",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "pitchfinder": "^2.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-easy-crop": "^5.5.6",
    "react-helmet-async": "^3.0.0",
    "react-konva": "^19.2.0",
    "react-resize-detector": "^12.1.0",
    "react-router-dom": "^7.7.0",
    "signalsmith-stretch": "1.3.2",
    "smplr": "0.26.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.11",
    "tonal": "^6.4.2",
    "tone": "^15.1.22",
    "uuid": "^11.1.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/material-icon-theme": "^1.2.69",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.4",
    "@lingui/cli": "^6.4.0",
    "@lingui/conf": "^6.4.0",
    "@lingui/format-po": "^6.4.0",
    "@lingui/swc-plugin": "^6.5.0",
    "@lingui/vite-plugin": "^6.4.0",
    "@playwright/test": "^1.59.1",
    "@tanstack/eslint-plugin-query": "^5.81.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.30.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-lingui": "^0.14.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^28.1.0",
    "knip": "^6.24.0",
    "prettier": "^3.4.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.1.7",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
