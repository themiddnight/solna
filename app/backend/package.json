{
  "name": "collab-backend",
  "version": "1.0.0",
  "description": "Backend service for COLLAB - Jam Band application",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "start:dev": "nodemon --watch src --watch ../../shared/dist/index.js -e ts,js --exec \"node --import tsx\" src/index.ts",
    "start:dev:gc": "NODE_ENV=development ENABLE_GC=true nodemon --watch src -e ts --exec \"node --import tsx\" src/index.ts",
    "build": "prisma generate && tsc && tsc-alias",
    "lint:runtime": "eslint src --ext .ts",
    "lint:tests": "eslint tests --ext .ts",
    "lint:scripts": "eslint scripts --ext .ts",
    "lint:strict": "bun run lint:runtime && bun run lint:tests && bun run lint:scripts",
    "lint": "bun run lint:strict",
    "lint:fix": "eslint . --ext .ts --fix",
    "clean": "rm -rf dist",
    "type-check:src": "tsc --noEmit -p tsconfig.json",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "type-check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "type-check": "bun run type-check:src && bun run type-check:tests && bun run type-check:scripts",
    "test": "bun run test:unit && bun run test:integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathIgnorePatterns='integration.test.ts|saveFromRoom.simplified.test.ts|regression.test.ts|fixtures/'",
    "test:integration": "jest --runInBand --forceExit --testPathPatterns='integration.test.ts|saveFromRoom.simplified.test.ts'",
    "test:pre-commit": "jest --testPathIgnorePatterns='integration.test.ts|saveFromRoom.simplified.test.ts|regression.test.ts|fixtures/'",
    "test:ci": "bun run test:unit && bun run test:integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:parallel": "jest",
    "test:changed": "jest --onlyChanged",
    "test:related": "jest --findRelatedTests",
    "test:webrtc": "bun run scripts/test-webrtc-https.ts",
    "test:approval": "jest --testPathPatterns=ApprovalWorkflowHandler.test.ts --verbose",
    "test:https": "jest --testPathPatterns=HTTPSWebRTC.test.ts --verbose",
    "test:https:run": "bun run scripts/test-https-webrtc.ts",
    "test:https:validate": "bun run scripts/validate-https-setup.ts",
    "test:load": "bun run scripts/run-load-tests.ts",
    "sync:b2:stg2dev": "bun run scripts/sync-b2-stg2dev.ts",
    "seed:e2e-users": "bun run scripts/seed-e2e-users.ts",
    "reset:e2e-tour": "bun run scripts/reset-e2e-onboarding-tour.ts",
    "test:performance": "bun run scripts/test-performance-monitoring.ts",
    "test:regression": "jest --testPathPatterns='regression.test.ts'",
    "test:domains": "jest src/domains/ai-generation/__tests__/AiGenerationService.test.ts src/domains/ai-generation/__tests__/AiJobQueueService.test.ts src/domains/lobby-management/__tests__/LobbyApplicationService.test.ts src/domains/lobby-management/__tests__/RoomDiscoveryService.test.ts src/domains/audio-processing/__tests__/AudioProcessingService.test.ts src/domains/real-time-communication/__tests__/AudioCommunicationService.test.ts src/domains/user-management/__tests__/AiSettingsService.test.ts --forceExit",
    "test:domains:watch": "jest --watch src/domains/**/__tests__/*.test.ts",
    "test:domains:coverage": "jest --coverage src/domains/**/__tests__/*.test.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "backend",
    "jam-band"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/genai": "^1.31.0",
    "@jam-band/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lru-cache": "^11.5.1",
    "midi-writer-js": "^3.1.1",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "openai": "^6.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "prisma": "^7.0.1",
    "redis": "^5.10.0",
    "resend": "^3.4.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@jest/globals": "^30.4.1",
    "@smithy/util-stream": "^4.8.2",
    "@tonejs/midi": "^2.0.28",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.2.21",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cache": "^4.2.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jest": "^30.0.5",
    "nodemon": "^3.1.14",
    "selfsigned": "^3.0.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.45.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
