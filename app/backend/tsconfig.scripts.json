{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "bun"],
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.ts", "prisma.config.ts", "src/testing/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/testing/mocks.ts"]
}
